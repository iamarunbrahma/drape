# YouCam API (Perfect Corp) credentials — get these from https://yce.perfectcorp.com API console.
# Both are SERVER-SIDE ONLY. Never expose client-side.
# YOUCAM_SECRET_KEY is an RSA public key (base64 DER) used to mint the S2S id_token.
YOUCAM_API_KEY=your-api-key-here
YOUCAM_SECRET_KEY=your-rsa-public-key-base64-here
